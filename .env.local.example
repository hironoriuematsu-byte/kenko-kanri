# 開発中: 無料の開発用Supabaseプロジェクトの値を設定
# 本運用時: 既存ストレスチェックWebと同じSupabaseプロジェクトの値に差し替え
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# メール通知(Phase 2以降で使用。既存と同じResendキー)
# RESEND_API_KEY=re_...

# ストレスチェックWebへのリンク(設定するとヘッダーに導線が表示されます)
# 未設定の場合はリンクを表示しません
# NEXT_PUBLIC_STRESS_URL=https://stres.mestate.jp

# 産業医面談ルーム(Google Meet)。未設定でも、Meet のリンクを手入力すれば使える
# (その場合は在室状況・開催履歴は表示されない)。設定手順は README 参照
# GOOGLE_SERVICE_ACCOUNT_EMAIL=kenko-meet@xxxx.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_MEET_OWNER_EMAIL=sangyoui@mestate.jp
# GOOGLE_MEET_ACCESS_TYPE=TRUSTED

# 開発中: 無料の開発用Supabaseプロジェクトの値を設定
# 本運用時: 既存ストレスチェックWebと同じSupabaseプロジェクトの値に差し替え
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# メール通知(Phase 2以降で使用。既存と同じResendキー)
# RESEND_API_KEY=re_...

# ストレスチェックWebへのリンク(設定するとヘッダーに導線が表示されます)
# 未設定の場合はリンクを表示しません
# NEXT_PUBLIC_STRESS_URL=https://stres.mestate.jp

# 産業医面談ルーム(Google Meet)。未設定でも、Meet のリンクを手入力すれば使える
# (その場合は在室状況・開催履歴は表示されない)。設定手順は README 参照
# GOOGLE_SERVICE_ACCOUNT_EMAIL=kenko-meet@xxxx.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_MEET_OWNER_EMAIL=sangyoui@mestate.jp
# GOOGLE_MEET_ACCESS_TYPE=TRUSTED

# 健診結果の医師意見聴取Web(50人未満向けのWeb申込・/iken)。未設定の間は申込ページが「準備中」になる
# SUPABASE_SERVICE_ROLE_KEY=...            # ストレスチェックWebと同じ値(サーバーのみ。NEXT_PUBLIC_ を付けない)
# STRIPE_SECRET_KEY=rk_live_...            # ストレスチェックWebと同じ Stripe アカウントのキー
# STRIPE_WEBHOOK_SECRET=whsec_...          # https://kenko.mestate.jp/api/iken/webhook 用に作ったエンドポイントの署名シークレット
# NEXT_PUBLIC_SITE_URL=https://kenko.mestate.jp
# RESEND_API_KEY=re_... / SENDER_EMAIL=... # メール(ストレスチェックWebと同じ値)
